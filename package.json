{
  "name": "dashflow",
  "version": "2.0.1",
  "description": "Современный, адаптивный и расширяемый дашборд новой вкладки для браузера (React 19, Tailwind CSS 4, WXT, Manifest V3)",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "keywords": [
    "dashboard",
    "newtab",
    "chrome-extension",
    "react19",
    "tailwindcss4",
    "wxt",
    "manifest-v3",
    "widgets"
  ],
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.5",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "immer": "^10.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^2.2.4",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-grid-layout": "^1.3.6",
    "@wxt-dev/module-react": "^1.1.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wxt": "^0.19.27"
  },
  "overrides": {
    "@vitejs/plugin-react": "^4.3.4"
  }
}
